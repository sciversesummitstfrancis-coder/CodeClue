{
  "name": "codeclue",
  "productName": "CodeClue",
  "version": "0.1.0",
  "description": "A student-first coding IDE: VS Code-grade editing with BlueJ pedagogy — progressive clues, sandboxed runs, and a Code Pad.",
  "author": "CodeClue <codeclue@example.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.codeclue.app",
    "productName": "CodeClue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**",
      "node_modules/**/*"
    ],
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  }
}
